{
    "name": "easyagency/laravel-admin",
    "description": "Admin interface for Laravel",
    "keywords": [
        "laravel",
        "admin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "easyagency",
            "email": "support@easy-agency.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-translation-loader": "^2.8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "files": [
            "src/Support/helpers.php"
        ],
        "psr-4": {
            "Easyagency\\LaravelAdmin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Easyagency\\LaravelAdmin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Easyagency\\LaravelAdmin\\LaravelAdminServiceProvider"
            ],
            "aliases": {
                "LaravelAdmin": "Easyagency\\LaravelAdmin\\Facades\\LaravelAdmin"
            }
        }
    }
}
